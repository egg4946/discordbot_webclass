DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Optional: Bot所有者を自動取得できない場合にDiscordユーザーIDを指定します。
# DISCORD_OWNER_USER_ID=
# Optional: commands are registered to the server containing DISCORD_CHANNEL_ID by default.
# Set this if you want to force registration to a specific server.
# DISCORD_GUILD_ID=
WEBCLASS_LOGIN_URL=https://webclass.nanzan-u.ac.jp/webclass/login.php
WEBCLASS_USER_ID=
WEBCLASS_PASSWORD=

# Optional: comma-separated pages to inspect after login.
# WEBCLASS_TARGET_URLS=https://webclass.nanzan-u.ac.jp/webclass/...

# Optional: set false while debugging login in a visible browser.
# WEBCLASS_HEADLESS=true

# Optional reliability settings.
# WEBCLASS_RETRY_ATTEMPTS=3
# WEBCLASS_RETRY_DELAY_MS=30000
# LOG_RETENTION_DAYS=30
# Abort a hung check after this many minutes (max 100).
# CHECK_TIMEOUT_MINUTES=60

# Optional: `npm run task` (assignment answers). Claude Code CLI and Codex CLI are used with
# their subscription logins; API keys are not needed and are removed from the CLI environment.
# Defaults: claude-opus-5 / medium, gpt-5.6-sol / medium
# TASK_CLAUDE_MODEL=
# TASK_CLAUDE_EFFORT=
# TASK_CODEX_MODEL=
# TASK_CODEX_EFFORT=
# CLAUDE_CLI_PATH=
# CODEX_CLI_PATH=
# Optional: printed at the top of a report PDF built for a file-submission question.
# TASK_REPORT_AUTHOR=学籍番号 氏名
