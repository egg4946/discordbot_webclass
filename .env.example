# Set this if you want to force registration to a specific server.
# DISCORD_GUILD_ID=
WEBCLASS_LOGIN_URL=https://webclass.nanzan-u.ac.jp/webclass/login.php
WEBCLASS_USER_ID=
WEBCLASS_PASSWORD=

# Optional: comma-separated pages to inspect after login.
